<mxfile host="app.diagrams.net"><diagram name="Backend architecture" id="backend-architecture"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b style=&quot;font-size:20px&quot;&gt;DevBench backend architecture&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;Client → API → Route → Controller → Service → Repository (Prisma ORM) → Database. Labels on the right say where each concern is handled.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="50" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b style=&quot;font-size:15px&quot;&gt;Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Next.js frontend (rewrites /api/v1/* to the API, so auth cookies stay first party), Postman, Stripe webhook&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#334155;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="86" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b style=&quot;font-size:15px&quot;&gt;API (Express app.ts)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Global middleware: CORS for APP_URL, cookie-parser, express.raw for the Stripe webhook BEFORE express.json, mounts every module under /api/v1&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#4F46E5;fillColor=#EEF2FF;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="560" height="86" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b style=&quot;font-size:15px&quot;&gt;Route (module.route.ts)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Maps method + path to a controller and chains middleware: rateLimiter → auth(roles) → validateRequest(zod)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#4F46E5;fillColor=#EEF2FF;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="560" height="86" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:15px&quot;&gt;Controller (module.controller.ts)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Thin HTTP adapter wrapped in catchAsync: builds the caller {userId, role, companyId}, calls the service, replies with sendResponse&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#4F46E5;fillColor=#EEF2FF;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="560" height="86" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:15px&quot;&gt;Service (module.service.ts)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Business rules: company scoping, state checks (draft / published / expired), transactions, credit debits, grading, audit log, email&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#0D9488;fillColor=#F0FDFA;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="560" height="86" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:15px&quot;&gt;Repository / ORM (Prisma Client)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;Type-safe queries and $transaction from a split schema (prisma/schema/*.prisma); Prisma errors map to HTTP codes&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#B45309;fillColor=#FFFBEB;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="560" height="86" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:15px&quot;&gt;Database (PostgreSQL)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#334155&quot;&gt;17 tables, UUID keys, unique constraints and soft deletes (deletedAt)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#B45309;fillColor=#FFFBEB;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;strokeWidth=2;spacing=8;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="560" height="86" as="geometry"/></mxCell><mxCell id="c10" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;html=1;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;html=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;html=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;html=1;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;html=1;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;html=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Authentication and authorisation&lt;/b&gt;&lt;br&gt;auth(...roles): JWT from httpOnly cookie or Bearer header, user loaded and status checked, then role checked (403). optionalAuth() for public-or-signed-in routes." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#4F46E5;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=8;dashed=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="330" width="470" height="74" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Validation&lt;/b&gt;&lt;br&gt;validateRequest(schema) parses req.body with Zod. Failures become 400 ValidationError with errorDetails[]." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#4F46E5;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=8;dashed=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="420.0" width="470" height="74" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Error handling&lt;/b&gt;&lt;br&gt;catchAsync forwards any throw to globalErrorHandler, which maps createError, Zod and Prisma (P2002 / P2003 / P2025) errors to one envelope." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#DC2626;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=8;dashed=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="510.0" width="470" height="74" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Business validation&lt;/b&gt;&lt;br&gt;Services throw createError(status, message): 404 not in your company, 400 wrong state, 410 expired link." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;strokeColor=#0D9488;fillColor=#FFFFFF;fontSize=12;align=left;spacingLeft=10;spacingRight=8;dashed=1;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="660" y="600.0" width="470" height="74" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;External services used by the Service layer&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Upstash Redis&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;Hashed refresh tokens, OTPs, rate-limit counters, cached stats&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#64748B;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="976" width="260" height="70" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;Stripe&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;Checkout sessions; signed webhook adds credits&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#64748B;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="320" y="976" width="260" height="70" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;SMTP (Nodemailer + EJS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;OTP, invitation and team emails via trySendMail&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#64748B;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="976" width="260" height="70" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Cloudinary&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;File uploads&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#64748B;fillColor=#FFFFFF;fontColor=#0F172A;fontSize=13;fontFamily=Helvetica;spacing=6;" vertex="1" parent="1"><mxGeometry x="880" y="976" width="260" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>