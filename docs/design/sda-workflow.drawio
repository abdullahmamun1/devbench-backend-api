<mxfile host="app.diagrams.net"><diagram name="SDA workflow - submit an attempt" id="sda-workflow---submit-an-attempt"><mxGraphModel dx="1600" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;Client&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;Candidate browser&lt;br&gt;(Next.js exam screen)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#334155;fillColor=#F8FAFC;fontColor=#0F172A;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;API / App&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;Express app.ts&lt;br&gt;CORS, cookies, JSON body&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#4F46E5;fillColor=#EEF2FF;fontColor=#0F172A;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="310" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Route&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;attempt.route.ts&lt;br&gt;auth(CANDIDATE)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#4F46E5;fillColor=#EEF2FF;fontColor=#0F172A;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="580" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Controller&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;attempt.controller.ts&lt;br&gt;finalSubmit (catchAsync)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#4F46E5;fillColor=#EEF2FF;fontColor=#0F172A;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="850" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Service&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;attempt.service.ts +&lt;br&gt;attempt.util.ts (grading)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#0D9488;fillColor=#F0FDFA;fontColor=#0F172A;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Database&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569&quot;&gt;PostgreSQL via&lt;br&gt;Prisma ORM&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;strokeColor=#B45309;fillColor=#FFFBEB;fontColor=#0F172A;fontSize=14;fontFamily=Helvetica;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1390" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="c8" value="" style="endArrow=none;dashed=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="180" as="sourcePoint"/><mxPoint x="140.0" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c9" value="" style="endArrow=none;dashed=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410.0" y="180" as="sourcePoint"/><mxPoint x="410.0" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c10" value="" style="endArrow=none;dashed=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680.0" y="180" as="sourcePoint"/><mxPoint x="680.0" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c11" value="" style="endArrow=none;dashed=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950.0" y="180" as="sourcePoint"/><mxPoint x="950.0" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c12" value="" style="endArrow=none;dashed=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="180" as="sourcePoint"/><mxPoint x="1220.0" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c13" value="" style="endArrow=none;dashed=1;strokeColor=#94A3B8;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1490.0" y="180" as="sourcePoint"/><mxPoint x="1490.0" y="1400" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c14" value="&lt;b style=&quot;font-size:20px&quot;&gt;SDA workflow: Submit an assessment attempt&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;POST /api/v1/attempts/:id/submit, role CANDIDATE. Solid arrows are the request path, dashed arrows the response path, red the error path.&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1550" height="60" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;1&lt;/b&gt;  POST /api/v1/attempts/:id/submit&lt;br&gt;cookie: accessToken" style="endArrow=block;endFill=1;html=1;strokeColor=#4F46E5;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140.0" y="225" as="sourcePoint"/><mxPoint x="410.0" y="225" as="targetPoint"/><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="c16" value="Global middleware: CORS (APP_URL), cookie-parser, express.json, mounted under /api/v1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#4F46E5;fillColor=#FFFFFF;fontSize=11;align=left;spacingLeft=8;spacingRight=6;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="315.0" y="253" width="190" height="62" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;2&lt;/b&gt;  router.post(&#x27;/:id/submit&#x27;)" style="endArrow=block;endFill=1;html=1;strokeColor=#4F46E5;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410.0" y="349" as="sourcePoint"/><mxPoint x="680.0" y="349" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;auth(CANDIDATE)&lt;/b&gt;: read JWT from cookie or Bearer header, verify signature and expiry" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#4F46E5;fillColor=#FFFFFF;fontSize=11;align=left;spacingLeft=8;spacingRight=6;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="585.0" y="381" width="190" height="56" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;3&lt;/b&gt;  find user by id (+ company)" style="endArrow=block;endFill=1;html=1;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680.0" y="465" as="sourcePoint"/><mxPoint x="1490.0" y="465" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;4&lt;/b&gt;  user row" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#0D9488;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1490.0" y="527" as="sourcePoint"/><mxPoint x="680.0" y="527" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c21" value="Reject if missing (404), suspended / deleted or company suspended (403), role not CANDIDATE (403)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#DC2626;fillColor=#FEF2F2;fontSize=11;align=left;spacingLeft=8;spacingRight=6;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="585.0" y="549" width="190" height="56" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;5&lt;/b&gt;  next(): req.user = {userId, role, companyId}" style="endArrow=block;endFill=1;html=1;strokeColor=#4F46E5;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680.0" y="635" as="sourcePoint"/><mxPoint x="950.0" y="635" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;6&lt;/b&gt;  attemptService.finalSubmit(attemptId, caller)" style="endArrow=block;endFill=1;html=1;strokeColor=#4F46E5;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950.0" y="697" as="sourcePoint"/><mxPoint x="1220.0" y="697" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c24" value="&lt;b&gt;7&lt;/b&gt;  find attempt WHERE id AND candidateId = caller" style="endArrow=block;endFill=1;html=1;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="759" as="sourcePoint"/><mxPoint x="1490.0" y="759" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;b&gt;8&lt;/b&gt;  attempt (or null)" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#0D9488;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1490.0" y="821" as="sourcePoint"/><mxPoint x="1220.0" y="821" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c26" value="Not found or not the caller&#x27;s: &lt;b&gt;404&lt;/b&gt;&lt;br&gt;Already submitted: &lt;b&gt;400&lt;/b&gt;&lt;br&gt;Past expiresAt: finalize as AUTO_EXPIRY instead of failing" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#0D9488;fillColor=#FFFFFF;fontSize=11;align=left;spacingLeft=8;spacingRight=6;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1125.0" y="843" width="190" height="72" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;9&lt;/b&gt;  BEGIN $transaction: load assessment problems + submissions" style="endArrow=block;endFill=1;html=1;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="955" as="sourcePoint"/><mxPoint x="1490.0" y="955" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c28" value="&lt;b&gt;Grade&lt;/b&gt; (attemptUtil.finalizeAttempt)&lt;br&gt;MCQ: compare with correct option&lt;br&gt;Blank answer: FAILED, 0 points&lt;br&gt;CODING / WRITTEN: PENDING_REVIEW" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#0D9488;fillColor=#F0FDFA;fontSize=11;align=left;spacingLeft=8;spacingRight=6;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1125.0" y="995" width="190" height="92" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;10&lt;/b&gt;  INSERT SubmissionResult rows; UPDATE Attempt&lt;br&gt;status=SUBMITTED, totalScore (null if any pending)" style="endArrow=block;endFill=1;html=1;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1137" as="sourcePoint"/><mxPoint x="1490.0" y="1137" as="targetPoint"/><mxPoint x="0" y="-20" as="offset"/></mxGeometry></mxCell><mxCell id="c30" value="&lt;b&gt;11&lt;/b&gt;  INSERT AuditLog ATTEMPT_SUBMITTED; COMMIT" style="endArrow=block;endFill=1;html=1;strokeColor=#B45309;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1195" as="sourcePoint"/><mxPoint x="1490.0" y="1195" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;12&lt;/b&gt;  updated attempt" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#0D9488;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1490.0" y="1257" as="sourcePoint"/><mxPoint x="1220.0" y="1257" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c32" value="&lt;b&gt;13&lt;/b&gt;  attempt" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#0D9488;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220.0" y="1305" as="sourcePoint"/><mxPoint x="950.0" y="1305" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;14&lt;/b&gt;  200 { success: true, message: &quot;Attempt submitted successfully&quot;, data }" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#0D9488;strokeWidth=2;fontSize=12;fontColor=#0F172A;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950.0" y="1353" as="sourcePoint"/><mxPoint x="140.0" y="1353" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;Error path&lt;/b&gt;: any createError / Zod / Prisma error thrown in steps 3-11 is caught by catchAsync and sent to globalErrorHandler" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#DC2626;fillColor=#FEF2F2;fontSize=11;align=left;spacingLeft=8;spacingRight=6;fontColor=#0F172A;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="855.0" y="1395" width="190" height="66" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;E&lt;/b&gt;  4xx / 5xx { success: false, statusCode, name, message, errorDetails? }" style="endArrow=open;endFill=0;dashed=1;html=1;strokeColor=#DC2626;strokeWidth=2;fontSize=12;fontColor=#DC2626;labelBackgroundColor=none;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="950.0" y="1497" as="sourcePoint"/><mxPoint x="140.0" y="1497" as="targetPoint"/><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>