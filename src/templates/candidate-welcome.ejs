<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome to DevBench</title>
</head>
<body style="margin: 0; padding: 0; font-family: 'Segoe UI', -apple-system, BlinkMacSystemFont, Roboto, Helvetica, Arial, sans-serif; background-color: #0f172a; color: #f8fafc;">

    <table role="presentation" cellspacing="0" cellpadding="0" border="0" align="center" width="100%" style="max-width: 600px; margin: 40px auto; background-color: #1e293b; border-radius: 12px; overflow: hidden; border: 1px solid #334155; box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);">
        
        <tr>
            <td height="4" style="background: linear-gradient(90deg, #3b82f6, #6366f1);"></td>
        </tr>

        <!-- Header -->
        <tr>
            <td style="padding: 32px 40px 20px 40px;">
                <span style="font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; color: #3b82f6;">DevBench Candidate Profile</span>
                <h1 style="margin: 8px 0 0 0; color: #ffffff; font-size: 24px; font-weight: 600; letter-spacing: -0.5px;">Welcome, <%= name %>!</h1>
            </td>
        </tr>

        <!-- Body Content -->
        <tr>
            <td style="padding: 0 40px 32px 40px;">
                <p style="font-size: 16px; line-height: 1.6; color: #cbd5e1; margin-top: 0; margin-bottom: 20px;">
                    Your candidate account has been successfully verified for <strong><%= email %></strong>. You are now set up to complete technical assessments, coding tasks, and multiple-choice skill screenings managed by hiring organizations.
                </p>

                <p style="font-size: 14px; line-height: 1.5; color: #64748b; margin-bottom: 0;">
                    Make sure to append your profile details, headlines, and key programming skills using your candidate credentials.
                </p>
            </td>
        </tr>

        <!-- Footer -->
        <tr>
            <td style="background-color: #0f172a; padding: 24px 40px; text-align: left; font-size: 12px; color: #64748b; border-top: 1px solid #334155;">
                <p style="margin: 0 0 6px 0;">&copy; <%= new Date().getFullYear() %> DevBench Platform. All rights reserved.</p>
                <p style="margin: 0; line-height: 1.4;">Operational candidate transaction system pipeline.</p>
            </td>
        </tr>
    </table>

</body>
</html>
