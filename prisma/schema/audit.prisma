model AuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actorRole  UserRole
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
}
