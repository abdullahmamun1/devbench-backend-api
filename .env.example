NODE_ENV=development
PORT=5000
# Frontend origin. Used for CORS, Stripe redirect URLs and email links
APP_URL=http://localhost:3000

BCRYPT_SALT_ROUNDS=10

JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_SECONDS=604800

DATABASE_URL=postgresql://user:password@host:5432/devbench

STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Must match NEXT_PUBLIC_CREDIT_PRICE_CENTS in the frontend
CREDIT_PRICE_IN_CENTS=100

GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
MAIL_FROM="DevBench <no-reply@example.com>"

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# One-time codes (seconds)
REGISTRATION_OTP_TTL_SECONDS=300
FORGOT_PASSWORD_OTP_TTL_SECONDS=300

# Invitation links (days)
CANDIDATE_INVITATION_EXPIRES_IN_DAYS=7
TEAM_INVITATION_EXPIRES_IN_DAYS=7

# Admin stats cache
PLATFORM_STATS_CACHE_KEY=admin:platform-stats
PLATFORM_STATS_CACHE_TTL_SECONDS=600
# Months shown on the admin trend charts
TREND_MONTHS=6

# Seed accounts (created on server start if missing)
ADMIN_EMAIL=admin@devbench.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Admin User

COMPANY_OWNER_EMAIL=owner@acme.com
COMPANY_OWNER_PASSWORD=Owner@123
COMPANY_OWNER_NAME=Company Owner
COMPANY_NAME=Acme Corp

CANDIDATE_EMAIL=candidate@test.com
CANDIDATE_PASSWORD=Candidate@123
CANDIDATE_NAME=Test Candidate

ASSESSMENT_CREATOR_EMAIL=creator@acme.com
ASSESSMENT_CREATOR_PASSWORD=Creator@123
ASSESSMENT_CREATOR_NAME=Assessment Creator

EVALUATOR_EMAIL=evaluator@acme.com
EVALUATOR_PASSWORD=Evaluator@123
EVALUATOR_NAME=Evaluator User